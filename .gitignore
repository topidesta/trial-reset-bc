# Artefak build PyInstaller — bisa dibangun ulang, tidak perlu masuk Git
build/
*.spec

# Biner EXE: TIDAK di-commit. Dibangun ulang oleh .github/workflows/release.yml
# saat tag v* di-push, lalu dilampirkan ke GitHub Release. Ini menjaga riwayat
# repo tetap ringan (tiap build ~24 MB).
dist/*.exe
dist/SHA256SUMS.txt

# Backup nilai registry yang dihasilkan saat menjalankan tool
cacheid-backup.json
backup-cacheid.json
backup_test.json
_backup_test.json

# Log darurat bila dialog GUI gagal tampil
bc-reset-notify-error.log

# Cache Python
__pycache__/
*.py[cod]

# Runtime config asisten
.workbuddy-ai/
